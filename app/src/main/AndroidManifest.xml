<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Akses ke semua berkas di penyimpanan HP -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Melihat daftar semua aplikasi terpasang, untuk menu Manajemen aplikasi -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Layanan APK MCP: membuka port jaringan, tetap hidup di latar belakang, dan menampilkan notifikasinya -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Pengukur desibel membaca kerasnya suara dari mikrofon -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Membuka layar pemasang Android untuk APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Filemate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!--
            Dua ikon peluncur untuk Preferensi > ikon peluncur. Yang aktif hanya satu:
            LauncherDark (bawaan) memakai latar gelap, LauncherLight memakai latar terang.
            Keduanya membuka MainActivity yang sama.
        -->
        <activity-alias
            android:name=".LauncherDark"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherLight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Untuk membuka berkas dengan aplikasi lain -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Menerima hasil pemasangan APK dari sistem (Instalasi berhasil atau gagal) -->
        <receiver
            android:name=".apk.ApkInstallReceiver"
            android:exported="false" />

        <!-- Server MCP supaya aplikasi AI bisa memakai alat Filemate -->
        <service
            android:name=".mcp.McpService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Server MCP lokal yang dijalankan user untuk dihubungkan ke aplikasi AI" />
        </service>

        <!-- Menjaga server FTP/HTTP dan perekam aktivitas tetap hidup di latar belakang -->
        <service
            android:name=".net.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Server berkas lokal dan perekam aktivitas yang dijalankan user" />
        </service>

        <!-- Menyimpan pilihan bahasa aplikasi (Indonesia / English) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
